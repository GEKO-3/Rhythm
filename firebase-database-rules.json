{
  "rules": {
    ".read": false,
    ".write": false,
    
    "songs": {
      ".read": true,
      ".write": true
    },
    
    "songsMetadata": {
      ".read": true,
      ".write": true
    },
    
    "members": {
      ".read": true,
      ".write": true,
      "$memberId": {
        ".read": true,
        ".write": true,
        "kits": {
          ".read": true,
          ".write": true,
          "$kitId": {
            ".read": true,
            ".write": true,
            ".validate": "newData.isString()"
          }
        }
      }
    },
    
    "sponsors": {
      ".read": true,
      ".write": true,
      "$sponsorId": {
        ".read": true,
        ".write": true
      }
    },
    
    "applications": {
      ".read": true,
      ".write": true,
      "$applicationId": {
        ".read": true,
        ".write": true
      }
    },
    
    "events": {
      ".read": true,
      ".write": true
    },
    
    "approvedUsers": {
      ".read": true,
      ".write": true
    },
    
    "loginRequests": {
      ".read": true,
      ".write": true,
      "$requestId": {
        ".read": true,
        ".write": true
      }
    },
    
    "rejectedLogins": {
      ".read": true,
      ".write": true
    },
    
    "users": {
      ".read": true,
      ".write": true
    },
    
    "userTokens": {
      ".read": true,
      ".write": true,
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    
    "fcm-tokens": {
      ".read": true,
      ".write": true,
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    
    "pending_requests": {
      ".read": true,
      ".write": true,
      "$requestId": {
        ".read": true,
        ".write": true
      }
    },
    
    "rejected_requests": {
      ".read": true,
      ".write": true
    },
    
    "accessRequests": {
      ".read": true,
      ".write": true,
      "$requestId": {
        ".read": true,
        ".write": true
      }
    },
    
    "admin": {
      ".read": true,
      ".write": true
    },
    
    "version": {
      ".read": true,
      ".write": true
    },
    
    "pendingNotifications": {
      ".read": true,
      ".write": true,
      "$notificationId": {
        ".read": true,
        ".write": true
      }
    },
    
    "tshirtOrders": {
      ".read": true,
      ".write": true,
      "$deviceId": {
        ".read": true,
        ".write": true,
        "$orderId": {
          ".read": true,
          ".write": true
        }
      }
    },
    
    "allTshirtOrders": {
      ".read": true,
      ".write": true,
      "$orderId": {
        ".read": true,
        ".write": true
      }
    },
    
    "shirtOrders": {
      ".read": true,
      ".write": true,
      "$deviceId": {
        ".read": true,
        ".write": true,
        "$orderId": {
          ".read": true,
          ".write": true
        }
      }
    },
    
    "allShirtOrders": {
      ".read": true,
      ".write": true,
      "$orderId": {
        ".read": true,
        ".write": true
      }
    },
    
    "transliteration": {
      ".read": true,
      ".write": true,
      "specialCases": {
        ".read": true,
        ".write": true,
        "$caseId": {
          ".read": true,
          ".write": true
        }
      },
      "transliterationMap": {
        ".read": true,
        ".write": true
      },
      "vowelDiacritics": {
        ".read": true,
        ".write": true
      },
      "vowelConsonants": {
        ".read": true,
        ".write": true
      },
      "shaviyanisukun": {
        ".read": true,
        ".write": true
      }
    },
    
    "bookings": {
      ".read": true,
      ".write": true,
      "bookedDates": {
        ".read": true,
        ".write": true,
        "$dateId": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isString()"
        }
      }
    },
    
    "kits": {
      ".read": true,
      ".write": false,
      "inventory": {
        ".read": true,
        ".write": true,
        "$kitId": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['name'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}