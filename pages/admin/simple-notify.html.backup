                    return token && !token.startsWith('mock_token_');
                }).length;
                
                if (selected.length === 0) {
                    summary.textContent = 'No members selected';
                } else {
                    summary.textContent = `${selected.length} member(s) selected • ${withTokens} with active notifications`;
                }
            }
        }       }).length;
                
                if (selected.length === 0) {
                    summary.textContent = 'No members selected';
                } else {
                    summary.textContent = `${selected.length} member(s) selected • ${withTokens} with active notifications`;
                }
            }
        }

        // Handle form submission
        document.getElementById('notification-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            // Prepare recipients (access codes of members with valid tokens)
            let recipients = [];
            if (recipientType === 'all') {
                recipients = Object.values(members)
                    .filter(m => {
                        const token = m.userId ? userTokens[m.userId] : null;
                        return token && !token.startsWith('mock_token_');
                    })
                    .map(m => m.userId);
            } else {
                if (selectedMembers.size === 0) {
                    showResult('Please select at least one member', 'error');
                    return;
                }
                recipients = Array.from(selectedMembers)
                    .map(id => members[id])
                    .filter(m => {
                        const token = m.userId ? userTokens[m.userId] : null;
                        return token && !token.startsWith('mock_token_');
                    })
                    .map(m => m.userId);
            }       .map(m => m.memberId);
            } else {
                if (selectedMembers.size === 0) {
                    showResult('Please select at least one member', 'error');
                    return;
                }
                recipients = Array.from(selectedMembers).filter(id => {
                    const member = members[id];
                    return member.fcmToken && !member.fcmToken.startsWith('mock_token_');
                });
            }

            if (recipients.length === 0) {
                showResult('No recipients have notifications enabled', 'error');
                return;
            }

            // Show confirmation
            const confirmMsg = `Send notification to ${recipients.length} member(s)?`;
            if (!confirm(confirmMsg)) {
                return;
            }

            // Show loading overlay
            document.getElementById('loading-overlay').classList.add('active');
            document.getElementById('send-btn').disabled = true;

            try {
                // Generate the command
                const recipientList = recipients.join(',');
                const command = `node send-test-notification.js --title "${title.replace(/"/g, '\\"')}" --body "${body.replace(/"/g, '\\"')}" --recipients "${recipientList}"`;
                
                console.log('Generated command:', command);
                
                // Show success message with command
                showResult(
                    `✓ Command generated successfully!\n\n` +
                    `Copy and run this command in your terminal:\n\n` +
                    `${command}\n\n` +
                    `This will send the notification to ${recipients.length} member(s).`,
                    'success'
                );

                // Clear form
                document.getElementById('notification-title').value = '';
                document.getElementById('notification-body').value = '';
                
            } catch (error) {
                console.error('Error:', error);
                showResult('Failed to generate notification command: ' + error.message, 'error');
            } finally {
                document.getElementById('loading-overlay').classList.remove('active');
                document.getElementById('send-btn').disabled = false;
            }
        });

        // Show result message
        function showResult(message, type) {
            const resultDiv = document.getElementById('result-message');
            resultDiv.className = `result-message ${type}`;
            resultDiv.textContent = message;
            resultDiv.style.display = 'block';

            // Auto-hide after 15 seconds for success messages
            if (type === 'success') {
                setTimeout(() => {
                    resultDiv.style.display = 'none';
                }, 15000);
            }
        }
    </script>

    <script type="module" src="../../js/rhythm-unified-auth.js"></script>
</body>
</html>
